{
  "name": "piople",
  "version": "0.0.1",
  "type": "module",
  "description": "Protocol-first multi-agent multi-user collaboration core. Pi runs agents; piople owns the shared protocol.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/http/server.ts",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "sim": "node scripts/simulate.ts scenarios",
    "sim:live": "node scripts/simulate.ts scenarios --live"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
