{
  "name": "routing-synthetic",
  "note": "Authored together with the keyword baseline. It exercises the harness and shows failure modes (no stemming, other languages, off-topic text with overlapping words, senders without access). It says NOTHING about real traffic: measure thresholds on your own messages.",
  "contexts": [
    { "id": "realm-infra", "kind": "realm", "title": "Infrastructure realm" },
    { "id": "ch-incidents", "kind": "channel", "realm": "realm-infra", "title": "Production incidents outage servers crashing" },
