[Unit]
Description=Piople protocol server (HTTP JSON + SSE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tiny/projects/piople
Environment=PATH=/opt/opencode-go-node/bin:/usr/bin:/bin
Environment=PIO_PORT=8899
Environment=PIO_DATA=/home/tiny/projects/piople/data/live.sqlite
Environment=PIO_AUTH_MODE=dev
ExecStart=/opt/opencode-go-node/bin/node src/http/server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
